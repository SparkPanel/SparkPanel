# Скопируйте в .env и измените значения.

# Секрет сессий. Если не задан — генерируется автоматически и сохраняется в каталоге данных.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Учётная запись, создаваемая при первом запуске (только если пользователей ещё нет)
ADMIN_USERNAME=adplayer
ADMIN_PASSWORD=0000

# Порт панели
PORT=5000
# Для docker-compose: порт на хосте
PANEL_PORT=5000

# Пароль PostgreSQL для docker-compose
POSTGRES_PASSWORD=sparkpanel

# PostgreSQL при запуске без Docker (если не задан — данные хранятся в data/storage.json)
# DATABASE_URL=postgresql://sparkpanel:sparkpanel@localhost:5432/sparkpanel

# Каталог данных (бэкапы, файловое хранилище, настройки)
# DATA_DIR=./data

# За обратным прокси (nginx): число прокси перед панелью, обычно 1
# TRUST_PROXY=1
# Включите при работе через HTTPS (secure-cookie)
# FORCE_HTTPS=true

# Максимальный размер загружаемого файла в файловом менеджере (МБ)
# UPLOAD_MAX_MB=512
# Первый порт для автоматического выделения SFTP-портов серверов
# SFTP_PORT_START=2022
